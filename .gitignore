# Generated dataset test output and synthetic CSV exports
datasets/synthetic/test_output/
datasets/synthetic/*.csv
datasets/synthetic/*backup*
datasets/synthetic/*_backup*
datasets/synthetic/*_old*

# Temporary editor backup files
*.bkp

